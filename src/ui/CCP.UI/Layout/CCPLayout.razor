@using CCP.Shared.UIContext
@using CCP.Shared.ValueObjects
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase

@inject AuthenticationStateProvider AuthStateProvider
@inject IUIUserContext UserContext
@inject NavigationManager Navigation

<HeadContent>
    <link rel="stylesheet" href="css/app.css" />
    <script src="/js/scrollHelpers.js"></script>
</HeadContent>

<div class="ccp-shell @(_isDarkMode ? "" : "light")">

    <!-- SIDEBAR -->
    <aside class="ccp-sidebar">

        <!-- Brand -->
        <div class="ccp-brand">
            <div class="ccp-brand-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </div>
            <a href="/" class="ccp-brand-name">CCP</a>
        </div>

        <!-- Navigation -->
        <nav class="ccp-nav">

            <div class="ccp-nav-section">
                <span class="ccp-nav-label">Main</span>
                <ul>
                    <li>
                        <NavLink class="ccp-nav-item" href="/Dashboard" Match="NavLinkMatch.All">
                            <span class="ccp-nav-icon icon-indigo">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="3" y="3" width="7" height="7" rx="1" />
                                    <rect x="14" y="3" width="7" height="7" rx="1" />
                                    <rect x="3" y="14" width="7" height="7" rx="1" />
                                    <rect x="14" y="14" width="7" height="7" rx="1" />
                                </svg>
                            </span>
                            <span class="ccp-nav-text">Dashboard</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="ccp-nav-item" href="/my-tickets">
                            <span class="ccp-nav-icon icon-amber">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                                    <rect x="9" y="3" width="6" height="4" rx="1" />
                                    <path d="M9 12h6M9 16h4" />
                                </svg>
                            </span>
                            <span class="ccp-nav-text">My Tickets</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="ccp-nav-item" href="/tickets/create">
                            <span class="ccp-nav-icon icon-green">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                                    <rect x="9" y="3" width="6" height="4" rx="1" />
                                    <line x1="12" y1="11" x2="12" y2="17" />
                                    <line x1="9" y1="14" x2="15" y2="14" />
                                </svg>
                            </span>
                            <span class="ccp-nav-text">Create Ticket</span>
                        </NavLink>
                    </li>
                    @if (UserContext.IsInternalUser)
                    {
                        <li>
                            <NavLink class="ccp-nav-item" href="/tickets" Match="NavLinkMatch.All">
                                <span class="ccp-nav-icon icon-teal">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" />
                                        <rect x="9" y="3" width="6" height="4" rx="1" />
                                        <line x1="9" y1="12" x2="15" y2="12" />
                                        <line x1="9" y1="16" x2="12" y2="16" />
                                        <circle cx="17" cy="17" r="3" />
                                        <path d="M19.5 19.5l1.5 1.5" />
                                    </svg>
                                </span>
                                <span class="ccp-nav-text">Ticket Overview</span>
                            </NavLink>
                        </li>
                    }
                </ul>
            </div>

            <AuthorizeView Roles="@UserRolesExtensions.ManageOrganizationRoleString">
                <div class="ccp-nav-section">
                    <span class="ccp-nav-label">Organization Settings</span>
                    <ul>
                        <li>
                            <NavLink class="ccp-nav-item" href="/tenant-configuration">
                                <span class="ccp-nav-icon icon-purple">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-inbox" viewBox="0 0 16 16">
                                        <path d="M4.98 4a.5.5 0 0 0-.39.188L1.54 8H6a.5.5 0 0 1 .5.5 1.5 1.5 0 1 0 3 0A.5.5 0 0 1 10 8h4.46l-3.05-3.812A.5.5 0 0 0 11.02 4zm9.954 5H10.45a2.5 2.5 0 0 1-4.9 0H1.066l.32 2.562a.5.5 0 0 0 .497.438h12.234a.5.5 0 0 0 .496-.438zM3.809 3.563A1.5 1.5 0 0 1 4.981 3h6.038a1.5 1.5 0 0 1 1.172.563l3.7 4.625a.5.5 0 0 1 .105.374l-.39 3.124A1.5 1.5 0 0 1 14.117 13H1.883a1.5 1.5 0 0 1-1.489-1.314l-.39-3.124a.5.5 0 0 1 .106-.374z" />
                                    </svg>
                                </span>
                                <span class="ccp-nav-text">Domain Settings</span>
                            </NavLink>
                        </li>
                        <li>
                            <NavLink class="ccp-nav-item" href="/faq-configuration">
                                <span class="ccp-nav-icon icon-teal">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M4 19.5A2.5 2.5 0 016.5 17H20" />
                                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z" />
                                    </svg>
                                </span>
                                <span class="ccp-nav-text">Faq Configuration</span>
                            </NavLink>
                        </li>
                    </ul>
                </div>
            </AuthorizeView>

            <AuthorizeView Roles="@UserRolesExtensions.ManageUsersRoleString" Context="manageuserscontext">
                <div class="ccp-nav-section">
                    <span class="ccp-nav-label">Users</span>
                    <ul>
                        <li>
                            <NavLink class="ccp-nav-item" href="/support-users">
                                <span class="ccp-nav-icon icon-teal">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 18v-6a9 9 0 0118 0v6" />
                                        <path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />
                                    </svg>
                                </span>
                                <span class="ccp-nav-text">Support Users</span>
                            </NavLink>
                        </li>
                        <li>
                            <AuthorizeView Roles="@(UserRolesExtensions.ManageCustomersRoleString +","+ UserRolesExtensions.ManageUsersRoleString + ","+@UserRolesExtensions.PromoteUsersRoleString)">
                                <NavLink class="ccp-nav-item" href="/UserManagement">
                                    <span class="ccp-nav-icon icon-teal">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
                                            <circle cx="9" cy="7" r="4" />
                                            <line x1="19" y1="8" x2="19" y2="14" />
                                            <line x1="22" y1="11" x2="16" y2="11" />
                                        </svg>
                                    </span>
                                    <span class="ccp-nav-text">User Management</span>
                                </NavLink>
                            </AuthorizeView>
                        </li>
                    </ul>
                </div>
            </AuthorizeView>

        </nav>

        <!-- User Profile -->
        <div class="ccp-user">
            <div class="ccp-user-avatar">@UserContext.Initials</div>
            <div class="ccp-user-info">
                <span class="ccp-user-name">@UserContext.FullName</span>
                <span class="ccp-user-role">@UserContext.Role</span>
            </div>
            <button class="ccp-user-more" title="More options" @onclick="ToggleUserMenu">
                <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
                    <circle cx="5" cy="12" r="1.5" />
                    <circle cx="12" cy="12" r="1.5" />
                    <circle cx="19" cy="12" r="1.5" />
                </svg>
            </button>
            @if (_isUserMenuOpen)
            {
                <div class="ccp-dropdown-overlay" @onclick="ToggleUserMenu"></div>
                <div class="ccp-user-dropdown">
                    <button class="ccp-user-dropdown-item" @onclick="LogoutAsync">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" />
                        </svg>
                        <span>Log Out</span>
                    </button>
                </div>
            }
        </div>

    </aside>

    <!-- MAIN AREA -->
    <div class="ccp-main">
        <!-- Topbar -->
        <header class="ccp-topbar">
            <div class="ccp-topbar-left">
                <div class="ccp-search">
                    <svg class="ccp-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                    <input type="text" class="ccp-search-input" placeholder="Search tickets, customers..." />
                </div>
            </div>
            <div class="ccp-topbar-right">
                <button class="ccp-topbar-btn" title="Grid view">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                        <rect x="3" y="3" width="7" height="7" rx="1" />
                        <rect x="14" y="3" width="7" height="7" rx="1" />
                        <rect x="3" y="14" width="7" height="7" rx="1" />
                        <rect x="14" y="14" width="7" height="7" rx="1" />
                    </svg>
                </button>
                <button class="ccp-topbar-btn ccp-topbar-btn--bell" title="Notifications">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                        <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" />
                    </svg>
                    <span class="ccp-bell-dot"></span>
                </button>
                <button class="ccp-topbar-btn ccp-topbar-btn--theme" title="Toggle theme" @onclick="ToggleTheme">
                    @if (_isDarkMode)
                    {
                        <!-- Sun icon (click to switch to light) -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                            <circle cx="12" cy="12" r="5" />
                            <line x1="12" y1="1" x2="12" y2="3" />
                            <line x1="12" y1="21" x2="12" y2="23" />
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                            <line x1="1" y1="12" x2="3" y2="12" />
                            <line x1="21" y1="12" x2="23" y2="12" />
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                        </svg>
                    }
                    else
                    {
                        <!-- Moon icon (click to switch to dark) -->
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="17" height="17">
                            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
                        </svg>
                    }
                </button>
                <div class="ccp-topbar-avatar">@UserContext.Initials</div>
            </div>
        </header>

        <!-- Content -->
        <main class="ccp-content">
            @if (isLoading)
            {
                <div class="loading-spinner">Loading...</div>
            }
            else if (errorMessage != null)
            {
                <div class="error-message">@errorMessage</div>
            }
            else
            {
                @Body
            }
        </main>

    </div>
</div>

@code {
    private bool _isDarkMode = true;
    private bool _isUserMenuOpen = false;
    private bool isLoading = false;
    private string? errorMessage = null;

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void ToggleUserMenu()
    {
        _isUserMenuOpen = !_isUserMenuOpen;
    }

    private async Task LogoutAsync()
    {
        Navigation.NavigateTo("/authentication/logout", forceLoad: true);
    }
}
